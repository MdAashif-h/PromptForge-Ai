# ==========================================
# PromptForge AI - Root .gitignore
# ==========================================

# Environment & Secret Files
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# Python / Virtual Environments
venv/
.venv/
env/
backend/venv/
backend/env/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Node / Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Vector Store Persistence
*.db
*.sqlite
*.sqlite3
backend/database/*.db
backend/database/*.sqlite
backend/chromadb_store/data/
backend/data/
chroma_db/

# Temporary files & Scratch
tmp/
temp/
*.log

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
